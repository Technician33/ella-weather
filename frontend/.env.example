# Server-only - read by next.config.ts's rewrites(), never exposed to the
# browser (the browser only ever talks to this Next.js origin via /api/*,
# which is forwarded server-side to this URL).
#
# Local dev (no Docker): omit this entirely - it defaults to
# http://localhost:8000, matching `uvicorn app.main:app --port 8000` run
# directly on the host.
#
# Docker Compose: set this to the backend service's name on the compose
# network, e.g. BACKEND_URL=http://backend:8000 - NOT localhost, which
# inside a container refers to the container itself, not the backend
# container.
BACKEND_URL=http://localhost:8000
